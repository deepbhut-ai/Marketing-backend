# ── AutoSocial AI – FastAPI environment variables ───────────────────
# Copy this file to `.env` and adjust values for your environment.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/zetta_social
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:root@localhost:5432/zetta_social

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# JWT
AUTH_JWT_SECRET_KEY=change-me-in-production

# Zettalgor AI
ZETTALGOR_API_URL=https://api.zettalgor.com/v1/chat/completions
ZETTALGOR_API_KEY=ze_al_your_key_here
ZETTALGOR_MODEL=ZAi8

# Gemini
AI_KEY_FERNET_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Site
SITE_BASE_URL=https://agents.zettalgor.com
DEBUG=True

AUTOSTART_CELERY=True